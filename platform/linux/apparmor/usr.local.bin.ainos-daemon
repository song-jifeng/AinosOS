# ==========================================================================
# AinosOS - AppArmor Security Profile for AI Daemon
# Copyright (C) 2024 AinosOS Developers
# SPDX-License-Identifier: GPL-2.0-only
#
# AppArmor confinement profile for the AinosOS AI Daemon binary.
# Restricts file system access, network access, and capability use
# to the minimum required for AI inference operations.
#
# Install:
#   sudo cp usr.local.bin.ainos-daemon /etc/apparmor.d/
#   sudo apparmor_parser -r /etc/apparmor.d/usr.local.bin.ainos-daemon
#   sudo aa-enforce /usr/local/bin/ainos-daemon
#
# Verify:
#   sudo aa-status | grep ainos-daemon
#   sudo aa-logprof
#
# Debug (complain mode):
#   sudo aa-complain /usr/local/bin/ainos-daemon
#   tail -f /var/log/syslog | grep DENIED
# ==========================================================================

#include <tunables/global>

# Profile: /usr/local/bin/ainos-daemon
# Confinement: enforce (default), can be set to complain for debugging
profile ainos-daemon /usr/local/bin/ainos-daemon flags=(attach_disconnected) {

  # ==========================================================================
  # Include abstractions (base system access patterns)
  # ==========================================================================
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/ssl_certs>
  #include <abstractions/dbus>
  #include <abstractions/openssl>

  # ==========================================================================
  # Capabilities
  # ==========================================================================
  capability dac_override,          # Read config files owned by root
  capability net_bind_service,      # Bind to TCP/UDP ports
  capability net_raw,               # ICMP for network checks
  capability sys_nice,              # Set scheduling priority
  capability sys_ptrace,            # Attach to inference sub-processes
  capability ipc_lock,              # Lock memory for sensitive data
  capability setgid,                # Supplementary groups
  capability setuid,                # Supplementary groups

  # Explicitly denied capabilities
  # capability sys_admin,           # Not needed
  # capability sys_module,          # Not needed
  # capability sys_boot,            # Not needed
  # capability linux_immutable,     # Not needed

  # ==========================================================================
  # Network Access
  # ==========================================================================

  # Cloud API access (outbound HTTPS)
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,

  # Unix domain sockets (IPC with local clients)
  network unix stream,
  network unix dgram,

  # Netlink (for udev, thermal monitoring)
  network netlink raw,

  # ==========================================================================
  # Daemon Binary and Libraries
  # ==========================================================================

  # Daemon binary itself
  /usr/local/bin/ainos-daemon                 mr,

  # System libraries
  /usr/lib/**                                 mr,
  /usr/lib64/**                               mr,
  /lib/**                                     mr,
  /lib64/**                                   mr,

  # Runtime linker
  /etc/ld.so.cache                            r,
  /etc/ld.so.preload                          r,
  /etc/ld.so.conf                             r,
  /etc/ld.so.conf.d/*                         r,

  # ==========================================================================
  # Configuration Files
  # ==========================================================================

  /etc/ainos/                             r,
  /etc/ainos/**                           r,
  /etc/ainos/ai-daemon.conf               r,
  /etc/ainos/ai-daemon.toml               r,
  /etc/ainos/auth_token.txt               rw,
  /etc/ainos/ainos.key                    r,
  /etc/ainos/ainos.crt                    r,
  /etc/ainos/certs/**                     r,

  # ==========================================================================
  # Data Directories
  # ==========================================================================

  # Model storage
  /var/lib/ainos/                         rw,
  /var/lib/ainos/**                       rw,
  /var/lib/ainos/models/**                r,

  # Context data
  /var/lib/ainos/data/**                  rw,
  /var/lib/ainos/contexts/**              rw,
  /var/lib/ainos/cache/**                 rw,

  # Log files
  /var/log/ainos/                         rw,
  /var/log/ainos/**                       rw,

  # Runtime directory (sockets, PID files)
  /var/run/ainos/                         rw,
  /var/run/ainos/**                       rw,
  /var/run/ainos/sockets/**               rw,
  /var/run/ainos/state/**                 rw,

  # Cache directory
  /var/cache/ainos/                       rw,
  /var/cache/ainos/**                     rw,
  /var/cache/ainos/models/**              r,

  # ==========================================================================
  # System Files (Read-only)
  # ==========================================================================

  # CPU info
  /proc/cpuinfo                           r,
  /proc/meminfo                           r,
  /proc/stat                              r,
  /proc/loadavg                           r,
  /proc/uptime                            r,

  # Process info
  /proc/self/**                           rw,
  /proc/sys/kernel/random/boot_id         r,
  /proc/sys/vm/overcommit_memory          r,

  # System configuration
  /etc/os-release                         r,
  /etc/hostname                           r,
  /etc/hosts                              r,
  /etc/resolv.conf                        r,
  /etc/nsswitch.conf                      r,
  /etc/passwd                             r,
  /etc/group                              r,

  # Timezone
  /etc/localtime                          r,
  /usr/share/zoneinfo/**                  r,

  # ==========================================================================
  # Thermal Monitoring (sysfs)
  # ==========================================================================

  /sys/class/thermal/                     r,
  /sys/class/thermal/**                   r,
  /sys/class/thermal/thermal_zone*/temp   r,
  /sys/class/hwmon/                       r,
  /sys/class/hwmon/**                     r,
  /sys/devices/virtual/thermal/**         r,

  # ==========================================================================
  # GPU and Accelerator Access
  # ==========================================================================

  # DRM (Direct Rendering Manager)
  /dev/dri/                               rw,
  /dev/dri/card*                          rw,
  /dev/dri/renderD*                       rw,

  # NVIDIA
  /dev/nvidia*                            rw,
  /dev/nvidiactl                          rw,
  /dev/nvidia-caps/**                     rw,

  # AMD GPU
  /dev/kfd                                rw,

  # AI Accelerators
  /dev/accel*                             rw,
  /dev/apex*                              rw,
  /dev/habanalabs*                        rw,

  # Ainos kernel modules
  /dev/ai-proc                            rw,
  /dev/ai-scheduler                       rw,
  /dev/ai-tmpfs                           rw,
  /dev/ai-readahead                       rw,

  # ==========================================================================
  # cgroups v2 Access
  # ==========================================================================

  /sys/fs/cgroup/                         rw,
  /sys/fs/cgroup/**                       rw,
  /sys/fs/cgroup/ainos/**                 rw,

  # ==========================================================================
  # D-Bus Access
  # ==========================================================================

  # System bus (for D-Bus integration)
  /run/dbus/system_bus_socket             rw,
  /var/run/dbus/system_bus_socket         rw,

  # ==========================================================================
  # Systemd Integration
  # ==========================================================================

  # sd_notify (systemd watchdog / readiness notification)
  /run/systemd/notify                     rw,
  /run/systemd/journal/**                 rw,

  # Journal
  /run/systemd/journal/socket             rw,
  /dev/log                                rw,

  # ==========================================================================
  # Temporary Files
  # ==========================================================================

  /tmp/ainos-*                            rw,
  /tmp/**                                 rw,

  # ==========================================================================
  # Signal and ptrace
  # ==========================================================================

  signal (send) set=(
    hup int quit term stop cont
  ) peer=ainos-daemon,

  signal (receive) set=(
    hup int quit term stop cont
  ) peer=ainos-daemon,

  ptrace (trace) peer=ainos-daemon,

  # ==========================================================================
  # Explicitly Denied Paths
  # ==========================================================================

  # No shell access
  deny /bin/**                             x,
  deny /usr/bin/**                         x,
  deny /sbin/**                            x,
  deny /usr/sbin/**                        x,

  # No kernel module loading
  deny /sbin/modprobe                      x,
  deny /sbin/insmod                        x,
  deny /sbin/rmmod                         x,

  # No system configuration modification
  deny /etc/**                             w,
  deny /etc/shadow                         r,

  # No access to other users' home directories
  deny /home/**                            rw,
  deny /root/**                            rw,
}
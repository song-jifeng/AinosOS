// AI 编译器示例 - 排序算法
// 文件: sort.ai

// 冒泡排序
fn bubble_sort(arr: array<int>, n: int) {
    let i: int = 0;
    while (i < n - 1) {
        let j: int = 0;
        while (j < n - i - 1) {
            if (arr[j] > arr[j + 1]) {
                let temp: int = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

// 选择排序
fn selection_sort(arr: array<int>, n: int) {
    let i: int = 0;
    while (i < n - 1) {
        let min_idx: int = i;
        let j: int = i + 1;
        while (j < n) {
            if (arr[j] < arr[min_idx]) {
                min_idx = j;
            }
            j = j + 1;
        }
        if (min_idx != i) {
            let temp: int = arr[i];
            arr[i] = arr[min_idx];
            arr[min_idx] = temp;
        }
        i = i + 1;
    }
}

// 插入排序
fn insertion_sort(arr: array<int>, n: int) {
    let i: int = 1;
    while (i < n) {
        let key: int = arr[i];
        let j: int = i - 1;
        while (j >= 0 && arr[j] > key) {
            arr[j + 1] = arr[j];
            j = j - 1;
        }
        arr[j + 1] = key;
        i = i + 1;
    }
}

// 辅助函数：打印数组
fn print_array(arr: array<int>, n: int) {
    let i: int = 0;
    let output: string = "[";
    while (i < n) {
        output = output + arr[i];
        if (i < n - 1) {
            output = output + ", ";
        }
        i = i + 1;
    }
    output = output + "]";
    print(output);
}

fn main() -> int {
    // 测试数组
    let data: array<int> = [64, 34, 25, 12, 22, 11, 90];
    let n: int = 7;

    print("Original array:");
    print_array(data, n);

    // 测试冒泡排序
    let arr1: array<int> = data;
    bubble_sort(arr1, n);
    print("Bubble sorted:");
    print_array(arr1, n);

    // 测试选择排序
    let arr2: array<int> = [64, 34, 25, 12, 22, 11, 90];
    selection_sort(arr2, n);
    print("Selection sorted:");
    print_array(arr2, n);

    // 测试插入排序
    let arr3: array<int> = [64, 34, 25, 12, 22, 11, 90];
    insertion_sort(arr3, n);
    print("Insertion sorted:");
    print_array(arr3, n);

    return 0;
}
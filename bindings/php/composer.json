{
    "name": "ainos/ainos-php",
    "description": "Official PHP SDK for Ainos - High-performance AI inference server",
    "type": "library",
    "license": "MIT",
    "keywords": ["ainos", "ai", "inference", "llm", "machine-learning", "tcp", "ndjson"],
    "readme": "README.md",
    "authors": [
        {
            "name": "Ainos Contributors",
            "homepage": "https://github.com/ainos"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-sockets": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Ainos\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ainos\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-html coverage/",
        "analyse": "phpstan analyse src/ --level=max",
        "cs-fix": "php-cs-fixer fix src/ --rules=@PSR12",
        "example:basic": "php examples/basic_usage.php",
        "example:streaming": "php examples/streaming.php"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/ainos/ainos-php/issues",
        "source": "https://github.com/ainos/ainos-php",
        "docs": "https://docs.ainos.ai"
    }
}
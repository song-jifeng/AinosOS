{
  "name": "ainos-sdk",
  "version": "0.1.0",
  "description": "Node.js/TypeScript SDK for the Ainos AI Daemon — TCP/IP NDJSON client",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepack": "npm run build",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "example": "ts-node examples/basic.ts"
  },
  "keywords": [
    "ainos",
    "ai",
    "daemon",
    "ipc",
    "ndjson",
    "tcp",
    "sdk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ainos-os/ainos-sdk-node.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}